{
  "name": "gentle-slash-frecency",
  "version": "0.2.0",
  "description": "Pi extension that sorts the slash-command autocomplete by frecency, so the skills and prompts you use most appear first.",
  "license": "MIT",
  "author": "Pablo Miguez",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiguezPablo/gentle-slash-frecency.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "gentle-shell",
    "frecency",
    "slash-commands",
    "skills",
    "autocomplete"
  ],
  "pi": {
    "extensions": [
      "./extensions/gentle-slash-frecency.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
